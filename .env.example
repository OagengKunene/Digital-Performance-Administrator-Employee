# Codespaces supplies DATABASE_URL automatically. Preserve its configured value.
# Docker Compose supplies its own internal PostgreSQL URL.
GOOGLE_API_KEY=
GROQ_API_KEY=
# gemini | groq | offline (offline = deterministic rules, no key)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-20b
# Optional and explicit; leave empty to avoid switching providers automatically.
# optional: gemini | groq | offline
AI_FALLBACK_PROVIDER=
AI_TIMEOUT_SECONDS=300
AI_MAX_MODEL_CALLS=10
AI_REQUESTS_PER_MINUTE=4
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY_SECONDS=15
WORKER_POLL_SECONDS=2
AUTONOMOUS_DAILY_REPORT_LIMIT=1

# Source CSV exports are watched without a user prompt.
INGESTION_INBOX_ROOT=.local/assessment-inbox
INGESTION_SETTLE_SECONDS=2
CAPTURE_RETRY_SECONDS=900
# In-app delivery is always enabled. SMTP adds email for opted-in real staff accounts.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_RETRY_ATTEMPTS=5

# Photo script demo: auto prefers AI_PROVIDER, then another configured vision reader, then local OCR.
# AI_PROVIDER=offline keeps automatic photo reading local.
# A separate vision model is required: the text-only Groq report model cannot read images.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Empty uses GEMINI_MODEL.
GEMINI_VISION_MODEL=
PHOTO_TIMEOUT_SECONDS=120
