# Codespaces supplies DATABASE_URL automatically through devcontainer.json.
# Local Docker Compose default: postgres:// is converted explicitly by SQLAlchemy's psycopg driver.
DATABASE_URL=postgresql+psycopg://pae:pae_local_only@db:5432/pae
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_SECONDS=90
AI_MAX_MODEL_CALLS=12
